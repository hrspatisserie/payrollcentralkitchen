const AUG_OT_BREAKDOWN = {"kitchen": {"ot15": 3140.66, "hw": 9500, "hot": 562.5}, "foreign": {"ot15": 23594.0, "hw": 39150, "hot": 375}};

const INK="#2B241C", PAPER="#F7F1E4", OVEN="#C1611D", CRUST="#8A5A2B", SAGE="#5F7A5A", CLAY="#B4552F";

const fmt = (n) => Math.round(n).toLocaleString("th-TH");
const fmt2 = (n) => n.toLocaleString("th-TH", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

let monthFilter = "ALL";
let sortDesc = true;
let query = "";

document.getElementById("empCount").textContent = EMPLOYEES.length;

const maxOtMonth = MONTHLY.reduce((a,b)=> b.ot > a.ot ? b : a);
const maxIncomeMonth = MONTHLY.reduce((a,b)=> b.income > a.income ? b : a);
const totalIncomeAll = MONTHLY.reduce((s,m)=> s+m.income, 0);
const totalOtAll = MONTHLY.reduce((s,m)=> s+m.ot, 0);

function renderChips(){
  const wrap = document.getElementById("chips");
  wrap.innerHTML = "";
  const allChip = document.createElement("span");
  allChip.className = "chip";
  allChip.textContent = "ทั้งหมด (8 เดือน)";
  Object.assign(allChip.style, {
    padding:"6px 14px", borderRadius:"999px", fontSize:"13px", fontWeight:"600",
    background: monthFilter==="ALL" ? INK : "#fff",
    color: monthFilter==="ALL" ? PAPER : INK,
    border: `1px solid ${INK}`
  });
  allChip.onclick = () => { monthFilter = "ALL"; renderAll(); };
  wrap.appendChild(allChip);

  MONTHLY.forEach(m => {
    const chip = document.createElement("span");
    chip.className = "chip";
    chip.textContent = m.label;
    Object.assign(chip.style, {
      padding:"6px 14px", borderRadius:"999px", fontSize:"13px", fontWeight:"600",
      background: monthFilter===m.key ? OVEN : "#fff",
      color: monthFilter===m.key ? PAPER : INK,
      border: `1px solid ${monthFilter===m.key ? OVEN : CRUST+"55"}`
    });
    chip.onclick = () => { monthFilter = m.key; renderAll(); };
    wrap.appendChild(chip);
  });
}

function kpiCard({icon,label,value,sub,highlight}){
  const div = document.createElement("div");
  div.className = "kpi-card";
  div.style.background = highlight ? INK : "#fff";
  div.style.color = highlight ? PAPER : INK;
  div.style.border = `1px solid ${highlight ? INK : CRUST+"33"}`;
  div.innerHTML = `
    <div style="display:flex; align-items:center; gap:6px; margin-bottom:8px;">
      <span>${icon}</span>
      <span class="kpi-label" style="color:${highlight ? PAPER+"cc" : CRUST};">${label}</span>
    </div>
    <div class="kpi-value num">${value}</div>
    <div class="kpi-sub num" style="color:${highlight ? PAPER+"aa" : CRUST};">${sub}</div>
  `;
  return div;
}

function renderKpis(){
  const wrap = document.getElementById("kpis");
  wrap.innerHTML = "";
  if (monthFilter === "ALL"){
    wrap.appendChild(kpiCard({icon:"💰", label:"ยอดรายรับสุทธิรวม 8 เดือน", value:`฿${fmt(totalIncomeAll)}`, sub:"รวมรายรับสุทธิทุกสาขา"}));
    wrap.appendChild(kpiCard({icon:"🔥", label:"ยอด OT รวม 8 เดือน", value:`฿${fmt(totalOtAll)}`, sub:"โอทีล่วงเวลาทุกประเภท"}));
    wrap.appendChild(kpiCard({icon:"🔥", label:"เดือนที่ OT สูงสุด", value:maxOtMonth.label, sub:`฿${fmt(maxOtMonth.ot)}`, highlight:true}));
    wrap.appendChild(kpiCard({icon:"💰", label:"เดือนที่รายรับสุทธิสูงสุด", value:maxIncomeMonth.label, sub:`฿${fmt(maxIncomeMonth.income)}`, highlight:true}));
  } else {
    const selected = MONTHLY.find(m => m.key === monthFilter);
    wrap.appendChild(kpiCard({icon:"💰", label:`รายรับสุทธิ เดือน ${selected.label}`, value:`฿${fmt(selected.income)}`, sub:"รวมรายรับสุทธิทุกสาขา", highlight:true}));
    wrap.appendChild(kpiCard({icon:"🔥", label:`OT รวม เดือน ${selected.label}`, value:`฿${fmt(selected.ot)}`, sub:`${((selected.ot/selected.income)*100).toFixed(1)}% ของรายรับสุทธิ`, highlight:true}));
    wrap.appendChild(kpiCard({icon:"👥", label:"พนักงานที่มีข้อมูล", value:`${selected.n} คน`, sub:`เดือน ${selected.label} 2569`}));
    wrap.appendChild(kpiCard({icon:"🔥", label:"OT เฉลี่ยต่อคน", value:`฿${fmt(selected.ot/selected.n)}`, sub:`เดือน ${selected.label}`}));

    if (selected.ot15 !== undefined){
      wrap.appendChild(kpiCard({icon:"⏱️", label:"โอทีล่วงเวลา (x1.5)", value:`฿${fmt(selected.ot15)}`, sub:`${((selected.ot15/selected.ot)*100).toFixed(1)}% ของ OT รวม`}));
      wrap.appendChild(kpiCard({icon:"📅", label:"ทำงานวันหยุด/นักขัตฤกษ์", value:`฿${fmt(selected.hw)}`, sub:`${((selected.hw/selected.ot)*100).toFixed(1)}% ของ OT รวม`}));
      wrap.appendChild(kpiCard({icon:"🎌", label:"โอทีล่วงเวลาวันหยุด", value:`฿${fmt(selected.hot)}`, sub:`${((selected.hot/selected.ot)*100).toFixed(1)}% ของ OT รวม`}));
    }
  }
}

let chart1, chart2, chart3;
function renderCharts(){
  const ctx1 = document.getElementById("chart1").getContext("2d");
  if (chart1) chart1.destroy();
  chart1 = new Chart(ctx1, {
    data: {
      labels: MONTHLY.map(m=>m.label),
      datasets: [
        { type:"bar", label:"รายรับสุทธิ", data: MONTHLY.map(m=>m.income), backgroundColor: CRUST, borderRadius:5, yAxisID:"y", order:2 },
        { type:"line", label:"โอที", data: MONTHLY.map(m=>m.ot), borderColor: OVEN, backgroundColor: OVEN, borderWidth:3, pointRadius:4, yAxisID:"y1", order:1 }
      ]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      plugins:{
        legend:{ display:false },
        tooltip:{
          callbacks:{
            label: (c) => `${c.dataset.label}: ฿${fmt2(c.raw)}`
          }
        }
      },
      scales:{
        y:{ position:"left", ticks:{ callback:(v)=>`${Math.round(v/1000)}k` }, grid:{ color:"#EDE3CC" } },
        y1:{ position:"right", ticks:{ callback:(v)=>`${Math.round(v/1000)}k`, color:OVEN }, grid:{ drawOnChartArea:false } }
      }
    }
  });

  const ctx2 = document.getElementById("chart2").getContext("2d");
  if (chart2) chart2.destroy();
  chart2 = new Chart(ctx2, {
    type:"line",
    data:{
      labels: BRANCH_TREND.map(m=>m.label),
      datasets:[
        { label:"ครัวกลาง", data: BRANCH_TREND.map(m=>m["ครัวกลาง"]), borderColor:CLAY, backgroundColor:CLAY, borderWidth:3, pointRadius:4 },
        { label:"ต่างชาติ", data: BRANCH_TREND.map(m=>m["ต่างชาติ"]), borderColor:SAGE, backgroundColor:SAGE, borderWidth:3, pointRadius:4 }
      ]
    },
    options:{
      responsive:true, maintainAspectRatio:false,
      plugins:{
        legend:{ display:false },
        tooltip:{ callbacks:{ label:(c)=>`${c.dataset.label}: ฿${fmt2(c.raw)}` } }
      },
      scales:{
        y:{ ticks:{ callback:(v)=>`${Math.round(v/1000)}k` }, grid:{ color:"#EDE3CC" } }
      }
    }
  });

  const chart3Card = document.getElementById("chart3Card");
  if (monthFilter === "082026"){
    chart3Card.style.display = "";
    const ctx3 = document.getElementById("chart3").getContext("2d");
    if (chart3) chart3.destroy();
    chart3 = new Chart(ctx3, {
      type:"bar",
      data:{
        labels: ["โอทีล่วงเวลา (x1.5)", "ทำงานวันหยุด/นักขัตฤกษ์", "โอทีล่วงเวลาวันหยุด"],
        datasets:[
          { label:"ครัวกลาง", data:[AUG_OT_BREAKDOWN.kitchen.ot15, AUG_OT_BREAKDOWN.kitchen.hw, AUG_OT_BREAKDOWN.kitchen.hot], backgroundColor: OVEN, borderRadius:5 },
          { label:"ต่างชาติ", data:[AUG_OT_BREAKDOWN.foreign.ot15, AUG_OT_BREAKDOWN.foreign.hw, AUG_OT_BREAKDOWN.foreign.hot], backgroundColor: SAGE, borderRadius:5 }
        ]
      },
      options:{
        responsive:true, maintainAspectRatio:false,
        plugins:{
          legend:{ display:false },
          tooltip:{ callbacks:{ label:(c)=>`${c.dataset.label}: ฿${fmt2(c.raw)}` } }
        },
        scales:{
          x:{ stacked:false },
          y:{ ticks:{ callback:(v)=>`${Math.round(v/1000)}k` }, grid:{ color:"#EDE3CC" } }
        }
      }
    });
  } else {
    chart3Card.style.display = "none";
    if (chart3) { chart3.destroy(); chart3 = null; }
  }
}

function getTableRows(){
  let rows;
  if (monthFilter === "ALL"){
    rows = EMPLOYEES.map(e => ({ id:e.id, name:e.name, branch:e.branch, value:e.total_ot, byMonth:e }));
  } else {
    rows = EMPLOYEES.filter(e => e[monthFilter] !== null && e[monthFilter] !== undefined)
      .map(e => ({ id:e.id, name:e.name, branch:e.branch, value:e[monthFilter], byMonth:e }));
  }
  const q = query.toLowerCase();
  rows = rows.filter(e => e.name.toLowerCase().includes(q) || e.id.includes(query));
  rows = rows.slice().sort((a,b)=> sortDesc ? b.value - a.value : a.value - b.value);
  return rows;
}

function monthChipLabel(key){ return MONTHLY.find(m=>m.key===key)?.label; }

function renderTable(){
  const title = document.getElementById("tableTitle");
  title.innerHTML = `🔥 รายชื่อ &amp; ยอด OT ${monthFilter==="ALL" ? "แยกรายเดือน (ม.ค.–ส.ค. 2569)" : `เดือน ${monthChipLabel(monthFilter)} 2569`}`;

  const thead = document.querySelector("#empTable thead");
  const tbody = document.querySelector("#empTable tbody");
  thead.innerHTML = "";
  tbody.innerHTML = "";

  const table = document.getElementById("empTable");
  table.style.minWidth = monthFilter === "ALL" ? "900px" : (monthFilter === "082026" ? "720px" : "480px");

  const trHead = document.createElement("tr");
  trHead.style.position = "sticky";
  trHead.style.top = "0";
  trHead.style.background = INK;
  trHead.style.color = PAPER;
  trHead.style.zIndex = "1";

  const headers = ["#", "รหัส", "ชื่อ-นามสกุล", "สาขา"];
  headers.forEach((h,i) => {
    const th = document.createElement("th");
    th.textContent = h;
    if (i >= 1 && i <= 2) th.style.textAlign = "left";
    if (i === 3) th.style.textAlign = "left";
    trHead.appendChild(th);
  });

  if (monthFilter === "ALL"){
    MONTHLY.forEach(m => {
      const th = document.createElement("th");
      th.textContent = m.label;
      th.style.textAlign = "right";
      trHead.appendChild(th);
    });
    const th = document.createElement("th");
    th.textContent = "รวม OT";
    th.style.textAlign = "right";
    th.style.background = OVEN;
    trHead.appendChild(th);
  } else if (monthFilter === "082026"){
    ["OT 1.5", "ทำงานวันหยุด", "โอทีวันหยุด", "รวม OT"].forEach((h,i) => {
      const th = document.createElement("th");
      th.textContent = h;
      th.style.textAlign = "right";
      if (i === 3) th.style.background = OVEN;
      trHead.appendChild(th);
    });
  } else {
    const th = document.createElement("th");
    th.textContent = "OT (บาท)";
    th.style.textAlign = "right";
    th.style.background = OVEN;
    trHead.appendChild(th);
  }
  thead.appendChild(trHead);

  const rows = getTableRows();
  rows.forEach((e,i) => {
    const tr = document.createElement("tr");
    tr.className = "row";
    tr.style.borderBottom = "1px solid #EDE3CC";

    const tdIdx = document.createElement("td");
    tdIdx.textContent = i+1;
    tdIdx.style.color = CRUST;
    tr.appendChild(tdIdx);

    const tdId = document.createElement("td");
    tdId.textContent = e.id;
    tdId.style.color = CRUST;
    tdId.className = "num";
    tr.appendChild(tdId);

    const tdName = document.createElement("td");
    tdName.textContent = e.name;
    tdName.style.fontWeight = "500";
    tr.appendChild(tdName);

    const tdBranch = document.createElement("td");
    tdBranch.textContent = e.branch;
    tdBranch.style.color = CRUST;
    tdBranch.style.fontSize = "12px";
    tr.appendChild(tdBranch);

    if (monthFilter === "ALL"){
      MONTHS.forEach(mk => {
        const td = document.createElement("td");
        const v = e.byMonth[mk];
        td.textContent = (v === null || v === undefined) ? "—" : fmt2(v);
        td.style.textAlign = "right";
        td.style.color = (v === null || v === undefined) ? "#c9bfa8" : INK;
        td.className = "num";
        tr.appendChild(td);
      });
      const tdTotal = document.createElement("td");
      tdTotal.textContent = fmt2(e.value);
      tdTotal.style.textAlign = "right";
      tdTotal.style.fontWeight = "700";
      tdTotal.style.color = OVEN;
      tdTotal.className = "num";
      tr.appendChild(tdTotal);
    } else if (monthFilter === "082026"){
      [e.byMonth["082026_ot15"], e.byMonth["082026_hw"], e.byMonth["082026_hot"]].forEach(v => {
        const td = document.createElement("td");
        td.textContent = (v === null || v === undefined) ? "—" : fmt2(v);
        td.style.textAlign = "right";
        td.style.color = (v === null || v === undefined) ? "#c9bfa8" : INK;
        td.className = "num";
        tr.appendChild(td);
      });
      const tdVal = document.createElement("td");
      tdVal.textContent = fmt2(e.value);
      tdVal.style.textAlign = "right";
      tdVal.style.fontWeight = "700";
      tdVal.style.color = OVEN;
      tdVal.className = "num";
      tr.appendChild(tdVal);
    } else {
      const tdVal = document.createElement("td");
      tdVal.textContent = fmt2(e.value);
      tdVal.style.textAlign = "right";
      tdVal.style.fontWeight = "700";
      tdVal.style.color = OVEN;
      tdVal.className = "num";
      tr.appendChild(tdVal);
    }
    tbody.appendChild(tr);
  });

  if (rows.length === 0){
    const tr = document.createElement("tr");
    const td = document.createElement("td");
    td.colSpan = 20;
    td.textContent = "ไม่พบข้อมูล";
    td.style.textAlign = "center";
    td.style.color = CRUST;
    td.style.padding = "24px";
    tr.appendChild(td);
    tbody.appendChild(tr);
  }
}

function renderAll(){
  renderChips();
  renderKpis();
  renderCharts();
  renderTable();
}

document.getElementById("searchBox").addEventListener("input", (e) => {
  query = e.target.value;
  renderTable();
});

document.getElementById("sortBtn").addEventListener("click", () => {
  sortDesc = !sortDesc;
  document.getElementById("sortLabel").textContent = sortDesc ? "มาก→น้อย" : "น้อย→มาก";
  renderTable();
});

renderAll();
</script>
</body>
</html>
